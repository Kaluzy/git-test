{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["iad1"],
  "functions": {
    "api/assistant-initialization.js": {
      "maxDuration": 10
    },
    "api/telnyx-events.js": {
      "maxDuration": 30
    },
    "api/lookup-open-thread.js": {
      "maxDuration": 15
    },
    "api/save-call-note.js": {
      "maxDuration": 15
    },
    "api/health.js": {
      "maxDuration": 10
    },
    "api/queues/process-call.js": {
      "maxDuration": 60,
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "nia-call-events",
          "maxConcurrency": 1,
          "maxDeliveries": 20,
          "retryAfterSeconds": 30
        }
      ]
    }
  }
}

