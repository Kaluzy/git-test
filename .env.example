# Configure these securely in the deployment environment. Never commit real tokens.
NIA_ASSISTANT_ID=assistant-REPLACE_WITH_NIA_ID
NIA_AGENT_NUMBER=+15555550100
NIA_INSIGHT_GROUP_ID=REPLACE_WITH_EXISTING_INSIGHT_GROUP_ID
NOTION_DATA_SOURCE_ID=REPLACE_WITH_EXISTING_NIA_CALL_LOG_DATA_SOURCE_ID

# Dedicated backend credentials; ChatGPT connector credentials are not reusable here.
TELNYX_API_KEY=
NOTION_TOKEN=

# Public Ed25519 key from GET https://api.telnyx.com/v2/public_key (data.public).
TELNYX_PUBLIC_KEY=

# Generate two DIFFERENT random secrets of at least 32 bytes.
# Keep the hash secret stable: changing it changes every private ledger key.
NIA_SESSION_SECRET=
NIA_LEDGER_HASH_SECRET=

# Match the deployed queue region in vercel.json. Keep preview and production separate.
NIA_REGION=iad1
NIA_LEDGER_NAMESPACE=production

# Attach a PRIVATE Vercel Blob store to this project/environment.
# Vercel project OIDC supplies storage/queue access when configured.
# BLOB_READ_WRITE_TOKEN is an optional explicit server-side Blob credential.
